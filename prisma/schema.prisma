// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TransactionType {
  INCOME
  EXPENSE
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Domain models
//
// Authentication (v1.5): `User` was designed from the first migration to be
// the ownership anchor every other table hangs a `userId` off of, precisely
// so a real Auth.js integration could thread a real session user through
// every existing query unchanged, rather than retrofitting isolation onto
// data that assumed a single user. This is that migration. `Account`,
// `Session`, and `VerificationToken` below are @auth/prisma-adapter's
// standard schema, additive only -- no existing table's shape changed
// beyond `User` gaining the four columns Auth.js's adapter expects
// (name, emailVerified, image, plus the new relations).
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  currency      String    @default("USD") @db.Char(3) // display formatting only; no FX conversion
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  categories     Category[]
  transactions   Transaction[]
  budgets        Budget[]
  savingsGoals   SavingsGoal[]
  contributions  SavingsContribution[]
  incomeSources  IncomeSource[]
  recurringBills RecurringBill[]
  billPayments   RecurringBillPayment[]

  @@map("users")
}

// @auth/prisma-adapter's standard shape -- see
// https://authjs.dev/getting-started/adapters/prisma. Untouched from the
// library's documented schema except @@map, matching this app's existing
// snake_case table-naming convention.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Database sessions (not JWT) -- deliberate, per docs/PROJECT_PLAN.md §8:
// instant server-side revocation (delete the row, the session is dead --
// impossible with JWTs without a denylist), rotation-on-sign-in as free
// fixation mitigation, and the DB is already in the request path via
// requireUserId() on every request regardless.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id     String       @id @default(cuid())
  userId String
  name   String       @db.VarChar(60)
  type   CategoryType

  color      String  @default("#64748b") @db.VarChar(7) // hex; validated server-side when writes exist
  icon       String? @db.VarChar(40)
  isArchived Boolean @default(false) // soft delete: categories with transaction history must not vanish
  isSystem   Boolean @default(false) // true for seeded default categories

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  budgets        Budget[]
  recurringBills RecurringBill[]

  @@unique([userId, type, name])
  @@unique([id, userId]) // target of the composite same-owner FK added in the migration
  @@index([userId, isArchived, sortOrder])
  @@map("categories")
}

model Transaction {
  id     String @id @default(cuid())
  userId String

  amountCents Int // always positive; direction is carried by `type`, never by sign
  type        TransactionType
  date        DateTime        @db.Date // calendar date, not an instant — avoids timezone month-drift

  description String  @db.VarChar(200)
  notes       String? @db.VarChar(1000)
  categoryId  String?

  // Optional link to the expected income source this transaction fulfills
  // (e.g. a paycheck) -- only meaningful for type = INCOME, never enforced
  // at the DB level since not every income transaction is tied to a
  // recurring source. See lib/incomeSources.ts for the expected-vs-received
  // computation this enables.
  incomeSourceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  incomeSource IncomeSource?         @relation(fields: [incomeSourceId], references: [id], onDelete: SetNull)
  billPayment  RecurringBillPayment?

  @@unique([id, userId]) // target of recurring_bill_payments_transaction_same_owner
  @@index([userId, date(sort: Desc), id]) // primary list ordering + keyset pagination
  @@index([userId, categoryId, date]) // category filter + per-category rollups
  @@index([userId, type, date]) // income/expense split for monthly summaries
  @@index([userId, amountCents]) // amount-range filter
  @@index([userId, incomeSourceId, date]) // expected-vs-received income rollup
  @@map("transactions")
}

model Budget {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  periodStart DateTime @db.Date // always the first day of the budgeted month
  amountCents Int
  notes       String?  @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, periodStart])
  @@index([userId, periodStart])
  @@map("budgets")
}

model SavingsGoal {
  id            String     @id @default(cuid())
  userId        String
  name          String     @db.VarChar(80)
  description   String?    @db.VarChar(500)
  targetCents   Int
  startingCents Int        @default(0) // progress = startingCents + SUM(contributions.amountCents)
  targetDate    DateTime?  @db.Date
  status        GoalStatus @default(ACTIVE)
  color         String     @default("#0ea5e9") @db.VarChar(7)
  achievedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]

  @@unique([userId, name])
  @@unique([id, userId]) // target of savings_contributions_goal_same_owner
  @@index([userId, status, targetDate])
  @@map("savings_goals")
}

// Progress is derived from this ledger rather than a mutable `currentCents`
// column on SavingsGoal: it gives contribution history for free (useful for
// a progress-over-time chart later), and it removes the drift risk of a
// denormalized running total that a failed write could desynchronize.
model SavingsContribution {
  id          String   @id @default(cuid())
  userId      String
  goalId      String
  amountCents Int // may be negative — a withdrawal
  date        DateTime @db.Date
  note        String?  @db.VarChar(200)
  createdAt   DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
  @@index([userId, date])
  @@map("savings_contributions")
}

// An expected recurring income (e.g. "Paycheck"). amountCents is a flat
// expected-per-occurrence amount -- v1.3 does not model variable-amount
// income (e.g. biweekly pay that differs month to month). payDay is
// clamped to the last day of short months at read time (lib/dates.ts),
// never stored pre-clamped, so a source created with payDay=31 still means
// "end of month" in February.
model IncomeSource {
  id          String   @id @default(cuid())
  userId      String
  name        String   @db.VarChar(80)
  amountCents Int
  payDay      Int // 1-31
  isActive    Boolean  @default(true)
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@unique([id, userId]) // target of transactions_income_source_same_owner
  @@index([userId, isActive])
  @@map("income_sources")
}

// A recurring monthly bill. Reminder-only by design (see docs/PROJECT_PLAN.md
// v1.3 notes): this app has no background worker, so nothing auto-posts a
// transaction on a due date. Paid/unpaid status per month is tracked via the
// explicit RecurringBillPayment ledger below, not derived from matching
// transactions -- the same reasoning as SavingsContribution above.
model RecurringBill {
  id          String   @id @default(cuid())
  userId      String
  name        String   @db.VarChar(80)
  amountCents Int
  categoryId  String? // used only if a payment logs a transaction
  dueDay      Int // 1-31
  isActive    Boolean  @default(true)
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments RecurringBillPayment[]

  @@unique([userId, name])
  @@unique([id, userId]) // target of recurring_bill_payments_bill_same_owner
  @@index([userId, isActive, dueDay])
  @@map("recurring_bills")
}

// One row per (bill, month) once marked paid. transactionId is set only
// when the "log a transaction for this" option was used when marking paid
// -- both writes happen inside one prisma.$transaction (server/data/recurringBills.ts)
// so a payment row can never exist without its transaction, or vice versa,
// when that option was chosen.
model RecurringBillPayment {
  id            String   @id @default(cuid())
  userId        String
  billId        String
  periodMonth   String   @db.VarChar(7) // "YYYY-MM"
  paidAt        DateTime @default(now())
  transactionId String?  @unique
  createdAt     DateTime @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill        RecurringBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  transaction Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([billId, periodMonth])
  @@index([userId, periodMonth])
  @@map("recurring_bill_payments")
}
