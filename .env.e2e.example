# Copy this file to .env.e2e and fill in real values for your machine.
# Never commit the real .env.e2e file.
#
# A DEDICATED database for the Playwright suite -- separate from both
# finance_dev (your real local data) and the Vitest integration suite's
# .env.test database. Playwright's global setup (e2e/global-setup.ts) runs
# `prisma migrate deploy` against this database, and every test resets and
# reseeds it before running (see e2e/fixtures.ts) -- it is truncated
# repeatedly and must never point at data you care about.
#
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://finance_app:CHANGE_ME@localhost:5432/finance_e2e?schema=public"

# A distinct identity from both the real dev user and the Vitest suite's,
# so all three can coexist in the same Postgres instance without ever being
# confused for one another. See server/context.ts.
DEV_USER_ID="e2e-dev-user"
