# Copy this file to .env.test to run the integration/unit test suite.
# Points at a SEPARATE database from .env's DATABASE_URL so running tests
# never touches your local dev data.

DATABASE_URL="postgresql://finance_app:CHANGE_ME@localhost:5432/finance_test?schema=public"

# See server/context.ts: the fixed development-user id used until Auth.js
# is implemented. tests/setup.ts creates a matching user row before tests run.
DEV_USER_ID="dev-user"
